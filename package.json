{
  "name": "font-awesome-icons",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --project example-app --host 0.0.0.0",
    "start:standalone": "ng serve --project example-app-standalone --host 0.0.0.0",
    "build": "npm run build:lib && npm run build:app && npm run build:standalone",
    "build:app": "npm run ng build example-app",
    "build:standalone": "npm run ng build example-app-standalone",
    "build:lib": "npm run build:lib:pre && npm run ng build font-awesome-icons-lib && npm run build:lib:post",
    "build:lib:pre": "npm run icons",
    "build:lib:post": "cpx 'projects/font-awesome-icons-lib/src/icons/**/*.{d.ts,js,mjs}' dist/font-awesome-icons/icons",
    "test": "jest --coverage",
    "test:lib": "jest --selectProjects font-awesome-icons-lib --coverage",
    "test:example": "jest --selectProjects example-app --coverage",
    "test:standalone": "jest --selectProjects example-app-standalone --coverage",
    "icons": "node ./util/rename-icon.js && svg-to-ts-files -s /*.svg -o -f icons && node ./util/unrename-icon.js",
    "lint": "prettier --check \"**/*.{ts,js,html,scss,json,md}\" && ng lint",
    "lint:fix": "prettier --write \"**/*.{ts,js,html,scss,json,md}\" && ng lint --fix",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.2",
    "svg-to-ts": "^12.0.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.8.0",
    "cpx": "^1.5.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.3.0",
    "prettier": "^3.10.1",
    "rxjs-marbles": "^7.0.1",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
